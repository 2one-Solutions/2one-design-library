{
  "name": "@2one/design-library",
  "version": "0.2.0",
  "type": "module",
  "description": "2one Design Language System — shadcn/ui components re-skinned to the 2one tokens (grayscale, light + audited dark, pill buttons, Satoshi + Inter).",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./api": "./scripts/api.mjs",
    "./styles": "./dist/styles.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist",
    "scripts",
    "skills",
    "brand",
    "graph.json",
    "manifest.json",
    "tokens",
    "graph",
    "rules",
    "AGENTS.md",
    "llms.txt",
    "dls.config.json",
    "dls.identity.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.config.dev.ts",
    "build:site": "vite build --config vite.config.dev.ts",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json && tsc-alias -p tsconfig.json && node scripts/copy-styles.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "a11y": "node scripts/apca-audit.mjs && node scripts/audit-graph-colors.mjs",
    "a11y:graph": "node scripts/audit-graph-colors.mjs",
    "verify:themes": "node scripts/verify-themes.mjs",
    "tokens": "node scripts/build-tokens.mjs && node scripts/build-dtcg.mjs",
    "manifest": "node scripts/build-manifest.mjs && node scripts/build-ai-entries.mjs",
    "validate": "node scripts/validate.mjs && node scripts/check-claims.mjs && node scripts/check-rules.mjs && node scripts/check-patterns.mjs && node scripts/check-ai-components.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "check:rules-compat": "node scripts/check-rules-compat.mjs",
    "check:patterns": "node scripts/check-patterns.mjs",
    "check:ai-components": "node scripts/check-ai-components.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:usage": "node scripts/check-usage.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:meta": "npm run build:meta && git diff --exit-code -- tokens integrations manifest.json graph.json CLAUDE.md GEMINI.md .cursorrules .github/copilot-instructions.md",
    "build:meta": "npm run tokens && npm run manifest && npm run graph && npm run graph:validate && npm run validate",
    "verify": "npm run typecheck && npm run check:exports && npm run validate && npm run graph:validate && npm run graph:test && npm run check:usage && npm run check:patterns && npm run check:ai-components && npm run check:graph-integrity && npm run check:i18n && npm run a11y && npm run check:package && npm run check:pill && npm run check:logo-sizing && npm run check:docs && npm run check:rules-compat && npm run check:meta && npm run evals && npm run test:fixture && npm run check:scan && npm run check:api && npm run check:seam && npm run check:mcp && npm run check:studio && npm run check:web-copy && npm run build",
    "graph": "node scripts/build-graph.mjs",
    "graph:validate": "node scripts/graph-validate.mjs",
    "graph:test": "node scripts/graph-decision-tests.mjs",
    "graph:decide": "node scripts/graph-decide.mjs",
    "what-uses": "node scripts/what-uses.mjs",
    "info": "node scripts/dls-info.mjs",
    "init": "node scripts/init-payload.mjs",
    "promote": "node scripts/promote-component.mjs",
    "ai-entries": "node scripts/build-ai-entries.mjs",
    "build:library": "node scripts/build-2one-library.mjs",
    "test:fixture": "node scripts/test-fixture.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:pill": "node scripts/check-pill.mjs",
    "check:logo-sizing": "node scripts/check-logo-sizing.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "evals": "node scripts/run-evals.mjs",
    "check:graph-integrity": "node scripts/check-graph-integrity.mjs",
    "check:scan": "node scripts/check-usage-scan.test.mjs",
    "check:api": "node scripts/engine-api.test.mjs",
    "check:seam": "node scripts/check-seam.mjs",
    "check:studio": "node studio/payload.test.mjs",
    "studio:seed": "node studio/scripts/seed-payload.mjs",
    "check:mcp": "npm --prefix mcp ci --no-audit --no-fund && node mcp/mcp.test.mjs",
    "check:web-copy": "node scripts/check-web-copy.mjs",
    "verify:visual": "playwright test",
    "test:visual": "playwright test screenshots.spec.ts",
    "test:visual:update": "playwright test --update-snapshots",
    "test:a11y": "playwright test tests/visual/specs",
    "test:report": "playwright show-report"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.12",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.85.0",
    "react-is": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "bin": {
    "2one": "./scripts/cli.mjs"
  }
}
